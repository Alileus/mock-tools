---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "alile.us · mock tools",
  description = "Sandbox utilities for generating format-valid test fixtures.",
} = Astro.props;

const nav = [
  { href: "/", label: "Hub" },
  { href: "/ksa", label: "KSA Fixtures" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-[760px] items-center gap-5 px-4 py-3">
        <a href="/" class="text-[13px] font-semibold tracking-[0.04em] text-txt">
          mock<span class="text-faint">.alile.us</span>
        </a>
        <div class="flex gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-active={(path === item.href).toString()}
                class="rounded-md px-2.5 py-1 text-[12px] text-dim transition-colors hover:text-txt data-[active=true]:bg-panel2 data-[active=true]:text-txt"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-[760px] px-4 py-8">
      <slot />
    </main>
  </body>
</html>
