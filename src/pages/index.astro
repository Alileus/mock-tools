---
import Layout from "../layouts/Layout.astro";
import ToolShell from "../components/ToolShell.astro";
import { HUB, TOOLS, REPOSITORY } from "../data/tools.mjs";
---

<Layout title={HUB.title} description={HUB.description} image="/og/home.png">
  <ToolShell title="Tools for building" subtitle="open source" description="Generate test data, convert text, and format JSON. Everything runs in your browser.">
    <div class="divide-y divide-line">
      {TOOLS.map((tool) => (
        <a href={tool.href} class="group block py-4 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="text-[13px] font-semibold text-txt group-hover:text-blue">{tool.name} →</span>
            <span class="text-[10px] uppercase tracking-[0.18em] text-faint">{tool.category}</span>
          </div>
          <p class="mt-2 text-[11.5px] leading-relaxed text-dim">{tool.blurb}</p>
        </a>
      ))}
    </div>
    <div class="mt-6 border-t border-line pt-5">
      <h2 class="text-[13px] font-semibold">Missing a tool?</h2>
      <p class="mt-2 text-[11.5px] leading-relaxed text-dim">New formats, more countries, or a utility you keep rewriting. Ideas and pull requests are welcome.</p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[11px]">
        <a class="text-blue hover:underline" href={`${REPOSITORY}/issues/new/choose`}>Suggest a tool →</a>
        <a class="text-blue hover:underline" href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`}>Contribute on GitHub →</a>
      </div>
    </div>
    <p slot="note">No account or API key needed. Regional identifiers are for sandbox testing and may overlap with real ones.</p>
  </ToolShell>
</Layout>
