{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/sa", "destination": "/sa/id", "permanent": true },
    { "source": "/ksa", "destination": "/sa/id", "permanent": true },
    { "source": "/ksa/:path*", "destination": "/sa/:path*", "permanent": true }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
