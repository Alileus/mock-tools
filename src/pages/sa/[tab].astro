---
import Layout from "../../layouts/Layout.astro";
import SaTool from "../../components/SaTool.astro";
import { SA_TABS } from "../../data/tools.mjs";

export function getStaticPaths() {
  return SA_TABS.map((t) => ({ params: { tab: t.key }, props: { tab: t } }));
}

const { tab } = Astro.props;
---

<Layout
  title={tab.title}
  description={tab.description}
  keywords={tab.keywords}
  image={`/og/${tab.key}.png`}
>
  <SaTool active={tab.key} />
</Layout>
