---
import Layout from "../layouts/Layout.astro";
import BatchTool from "../components/BatchTool.astro";
import ToolShell from "../components/ToolShell.astro";
---

<Layout title="Bulk UUID generator | mock.alile.us" description="Generate up to 1,000 random UUID v4 values in your browser. Copy or download as text or JSON.">
  <ToolShell title="Bulk UUIDs" description="Random UUID v4 values for your fixtures, database seeds, and API tests.">
    <BatchTool kind="uuid" />
    <p slot="note">Generated in your browser with Web Crypto. Each batch is new.</p>
  </ToolShell>
</Layout>
